    "content:export-sources": "node --loader ts-node/esm src/migrations/content-export-sources.ts",
    "content:import": "node --loader ts-node/esm src/migrations/content-import.ts",
    "content:lint": "node --loader ts-node/esm src/migrations/content-lint.ts",
    "seed:bonus-courses": "node --loader ts-node/esm src/migrations/seed-bonus-courses.ts",
    "seed:legal-pages": "node --loader ts-node/esm src/migrations/seed-legal-pages.ts",
    "migrate:followups": "node --loader ts-node/esm src/migrations/migrate-followups-to-messages.ts",
    "lifecycle:dry-run": "node --loader ts-node/esm scripts/lifecycle-dry-run.ts",
    "emails:preview": "node --loader ts-node/esm scripts/emails-preview.ts",
    "plan:preview": "node --loader ts-node/esm scripts/plan-preview.ts",
    "emails:baseline": "node --loader ts-node/esm scripts/email-baseline.ts",
    "seed:schools": "node --loader ts-node/esm src/migrations/seed-schools.ts",
    "test": "node --loader ts-node/esm src/lib/pricing.test.ts && node --loader ts-node/esm src/lib/rate-limiter.test.ts && node --loader ts-node/esm src/lib/guided-plan.test.ts && node --loader ts-node/esm src/lib/leads.test.ts && node --loader ts-node/esm src/lib/whatsapp.test.ts && node --loader ts-node/esm src/lib/school-lineup.test.ts && node --loader ts-node/esm src/lib/email.test.ts && node --loader ts-node/esm src/lib/billing.test.ts && node --loader ts-node/esm src/lib/drive-names.test.ts && node --loader ts-node/esm src/lib/captions.test.ts && node --loader ts-node/esm src/lib/assessments.test.ts && node --loader ts-node/esm src/lib/lifecycle/lifecycle.test.ts && node --loader ts-node/esm src/emails/lifecycle/honesty.test.ts && node --loader ts-node/esm src/emails/baseline.test.ts && node --loader ts-node/esm src/emails/copy.test.ts && node --loader ts-node/esm src/emails/validate-override.test.ts && node --loader ts-node/esm src/emails/override-store.test.ts && node --loader ts-node/esm src/emails/slot-coverage.test.ts && node --loader ts-node/esm src/endpoints/email/editor.test.ts && node --loader ts-node/esm src/admin/data/metrics.test.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "typecheck:admin": "tsc -p tsconfig.next.json --noEmit",
    "admin:theme": "node scripts/generate-admin-theme.mjs",
    "admin:contrast": "node scripts/check-admin-contrast.mjs",
    "admin:qa": "node scripts/studio-qa.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
