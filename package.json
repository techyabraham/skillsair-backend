{
  "name": "skillsair-backend",
  "version": "1.0.0",
  "description": "SkillsAir eLearning platform backend — Payload CMS 3.x on Node.js/TypeScript",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --loader ts-node/esm server.ts",
    "build": "tsc",
