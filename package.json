    "admin:build": "npm run admin:contrast && npm run generate:importmap && next build --webpack",
    "admin:start": "next start -p 3000",
    "start": "node dist/server.js",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "migrate:fallback": "node --loader ts-node/esm scripts/migrate-fallback.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:import:users": "node --loader ts-node/esm src/migrations/import-users.ts",
    "migrate:import:media": "node --loader ts-node/esm src/migrations/import-media.ts",
    "migrate:import:courses": "node --loader ts-node/esm src/migrations/import-courses.ts",
    "migrate:import:enrollments": "node --loader ts-node/esm src/migrations/import-enrollments.ts",
    "migrate:import:orders": "node --loader ts-node/esm src/migrations/import-orders.ts",
    "migrate:import:learning": "node --loader ts-node/esm src/migrations/import-learning-data.ts",
    "seed:rebuild-pricing": "node --loader ts-node/esm src/migrations/seed-rebuild-pricing.ts",
    "paystack:plan-fees": "node --loader ts-node/esm src/migrations/update-plan-fees.ts",
