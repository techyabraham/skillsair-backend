    "jsonwebtoken": "^9.0.2",
    "next": "^16.4.2",
    "node-cron": "^3.0.3",
    "payload": "latest",
    "pdfkit": "^0.15.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^4.0.1",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
