    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.7",
    "lucide-react": "^1.59.0",
    "playwright-core": "^1.64.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
