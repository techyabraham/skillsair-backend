# Example settings for skillsair-backend. Copy what you need into .env (never commit .env).
# This file lists settings added with the Ambassadors work; see README.md for the rest.

# Tests: a disposable LOCAL Postgres for the integration specs (npm test). The harness empties
# tables, so it refuses any host other than localhost. Leave unset to skip those specs.
TEST_DATABASE_URI=postgres://postgres@localhost:55432/amb_test

# Independent HS256 key for ambassador referral cookies; generate at least 32 random characters.
AMBASSADOR_ATTRIBUTION_SECRET=
# Absolute origin used for ambassador verification and password-reset links.
AMBASSADOR_PORTAL_URL=https://ambassador.skillsair.com
# Internal inbox for new ambassador application notifications.
AMBASSADOR_ADMIN_EMAIL=
# Main SkillsAir site origin used to build ambassador referral links.
MAIN_SITE_URL=https://skillsair.com
