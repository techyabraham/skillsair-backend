# Example settings for skillsair-backend. Copy what you need into .env (never commit .env).
# This file lists settings added with the Ambassadors work; see README.md for the rest.

# Tests: a disposable LOCAL Postgres for the integration specs (npm test). The harness empties
# tables, so it refuses any host other than localhost. Leave unset to skip those specs.
TEST_DATABASE_URI=postgres://postgres@localhost:55432/amb_test
