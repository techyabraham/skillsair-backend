# Server
NODE_ENV=production
PORT=3001
BACKEND_URL=https://kiwi.skillsair.com
PAYLOAD_SECRET=your-long-random-secret-min-32-chars
CORS_ORIGINS=https://skillsair.com,https://www.skillsair.com

# Database
DATABASE_URI=postgresql://user:password@host:5432/skillsair

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@skillsair.com
EMAIL_FROM_NAME=SkillsAir

# Cloudflare R2
R2_ACCOUNT_ID=xxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxx
R2_BUCKET=skillsair-media
R2_PUBLIC_URL=https://media.skillsair.com

# Google Drive
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Frontend
FRONTEND_URL=https://skillsair.com

# Certificate
CERTIFICATE_PRICE_NGN=10000

# Encryption (AES-256-GCM key for encrypting sensitive fields at rest, 32 bytes hex-encoded = 64 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# WhatsApp Cloud API (Meta). Nothing is sent unless WHATSAPP_ENABLED=true.
# Templates to submit in WhatsApp Manager: see docs/whatsapp-templates.md
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=system-user-token
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxx
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=a-long-random-string-you-also-enter-in-meta
WHATSAPP_API_VERSION=21.0

# Leads
LEAD_SUMMARY_EMAIL=hello@mail.skillsair.com
# Optional: origin of the Payload admin, used for links in the daily lead summary (defaults to BACKEND_URL)
ADMIN_URL=https://kiwi.skillsair.com

# Shared secret (32+ chars) that the frontend BFF sends so per-IP rate limits apply to the real
# visitor instead of the frontend server. Set the same value as BFF_SHARED_SECRET on the frontend.
BFF_SHARED_SECRET=
