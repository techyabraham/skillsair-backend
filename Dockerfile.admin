FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --include=dev --no-audit
COPY . .
# Coolify may set PAYLOAD_CONFIG_PATH to /app/dist/payload.config.js, as it
# does for the API service. Compile that config before generating the admin UI.
ENV NODE_ENV=production
RUN npm run build
RUN npm run admin:build

FROM node:20-alpine AS production
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --no-audit && npm cache clean --force
COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder --chown=node:node /app/src/app ./src/app
COPY --from=builder --chown=node:node /app/next.config.mjs ./next.config.mjs
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
EXPOSE 3000
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health',(r)=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["npm", "run", "admin:start"]
